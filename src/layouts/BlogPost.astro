---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Ad from '../components/Ad.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-md);
				width: 100%;
				max-height: 450px;
				object-fit: cover;
			}
			.prose {
				color: var(--black);
				font-size: 1.05rem;
			}
			.title {
				margin-bottom: 2em;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--gray);
				font-size: 0.95em;
			}
			.last-updated-on {
				font-style: italic;
			}
			/* Sidebar Widgets */
			.widget {
				padding: 1.5rem;
				margin-bottom: 2rem;
			}
			.widget-title {
				font-size: 1.1rem;
				font-weight: bold;
				color: var(--black);
				border-bottom: 2px solid var(--accent);
				padding-bottom: 0.5rem;
				margin-bottom: 1.2rem;
				display: inline-block;
			}
			.profile-pic {
				width: 80px;
				height: 80px;
				border-radius: 50%;
				margin: 0 auto 1rem;
				background-color: var(--gray-light);
				display: block;
			}
			.profile-desc {
				font-size: 0.9rem;
				color: var(--gray);
				text-align: center;
				line-height: 1.6;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="layout-container">
				<!-- メインコンテンツ (左カラム) -->
				<article class="layout-main card" style="padding: 2.5rem 2rem;">
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						
						<slot />
						
						<!-- 記事下広告 -->
						<div style="margin-top: 4rem;">
							<Ad />
						</div>
					</div>
				</article>

				<!-- サイドバー (右カラム) -->
				<aside class="layout-sidebar">
					<!-- プロフィールウィジェット -->
					<div class="widget card">
						<span class="widget-title">Profile</span>
						<div class="profile-pic"></div>
						<p class="profile-desc">
							IT・ビジネスの最前線で働くプロフェッショナル。<br/>効率化や最新テクノロジーの知見を発信します。
						</p>
					</div>

					<!-- サイドバー広告 -->
					<div class="widget card" style="padding: 1rem; text-align: center;">
						<span class="widget-title" style="font-size:0.9rem; color:var(--gray-light); border-bottom:none; margin-bottom:0.5rem;">Sponsored</span>
						<Ad />
					</div>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>
